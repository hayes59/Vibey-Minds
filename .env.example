NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ or ship to the browser.
# Used only by the webhook route to credit balances, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Crypto payment processor (NOWPayments / Coinbase Commerce / BTCPay Server).
# Leave unset to use the local dev-checkout simulator at /credits/dev-checkout.
CRYPTO_PROVIDER_API_KEY=
CRYPTO_PROVIDER_WEBHOOK_SECRET=

APP_URL=http://localhost:3000
